{
  "name": "gap2grow-learning-resource-agent",
  "version": "1.0.0",
  "description": "Agentic AI Learning Resource Agent for Vignan University",
  "scripts": {
    "postinstall": "npm --prefix frontend install --legacy-peer-deps",
    "dev": "node run-dev.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python -m uvicorn main:app --port 8000 --reload",
    "build": "npm --prefix frontend run build",
    "seed": "python backend/seed_data.py"
  },
  "keywords": [
    "education",
    "ai-agent",
    "learning-path",
    "gap-analysis",
    "vignan-university"
  ],
  "author": "Vignan University AI Team",
  "license": "ISC"
}
